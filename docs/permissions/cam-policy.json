{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "cvm:DescribeZones",
        "cvm:DescribeImages",
        "cvm:DescribeInstances",
        "cvm:DescribeInstanceTypeConfigs",
        "cvm:DescribeInstancesStatus"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "action": [
        "cvm:RunInstances",
        "cvm:CreateKeyPair"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "action": [
        "vpc:DescribeVpcs",
        "vpc:DescribeVpcEx",
        "vpc:DescribeSubnets",
        "vpc:DescribeSubnetEx",
        "vpc:DescribeSecurityGroups",
        "vpc:DescribeSecurityGroupEx",
        "vpc:DescribeSecurityGroupPolicies",
        "vpc:CreateSecurityGroup",
        "vpc:CreateSecurityGroupPolicies",
        "vpc:DeleteSecurityGroup",
        "vpc:AssociateSecurityGroups",
        "vpc:DescribeAddresses",
        "vpc:DescribeNetworkInterfaces"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "action": [
        "tag:AddResourceTag",
        "tag:DescribeTagKeys",
        "tag:DescribeTagValues",
        "tag:DescribeResourceTagsByResourceIds"
      ],
      "resource": "*"
    },
    {
      "effect": "allow",
      "action": [
        "cvm:TerminateInstances",
        "cvm:StopInstances"
      ],
      "resource": "*",
      "condition": {
        "for_any_value:string_equal": {
          "qcs:resource_tag": ["ManagedBy&VPNSpawner"]
        }
      }
    }
  ]
}
